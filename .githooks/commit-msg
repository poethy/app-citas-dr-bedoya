#!/bin/sh
# Rechaza commits con coautoría o firmas de herramientas de IA.
# Se activa una vez por clon con: git config core.hooksPath .githooks
patron="$(git rev-parse --show-toplevel)/.github/patron-coautor-ia.txt"
mensaje="$1"

if [ -f "$patron" ] && grep -v '^#' "$mensaje" | grep -Eiq -f "$patron"; then
  echo "✘ El mensaje del commit tiene una línea de coautoría o firma de IA:" >&2
  grep -v '^#' "$mensaje" | grep -Ei -f "$patron" | sed 's/^/    /' >&2
  echo "  Quítala y vuelve a hacer el commit (ver CONTRIBUTING.md › Commits)." >&2
  exit 1
fi
exit 0
