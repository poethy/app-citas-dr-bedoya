# Copia este archivo como .env y llena los valores (el .env no se sube al repo).
# Se obtienen en Supabase → Project Settings → API, o pídeselos al equipo por un canal privado.
# Las variables EXPO_PUBLIC_ viajan dentro de la app: NO son secretos. La seguridad la dan las políticas RLS.
EXPO_PUBLIC_SUPABASE_URL=https://<ref-del-proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<clave publishable (sb_publishable_...)>
