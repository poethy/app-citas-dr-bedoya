{
  "expo": {
    "name": "Citas Dr. Camilo Bedoya",
    "slug": "app-citas-dr-bedoya",
    "scheme": "citas-bedoya",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación solo mientras consultas el mapa del consultorio."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0b1f3a"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1f3a",
          "image": "./assets/imagenes/splash-monograma.png",
          "imageWidth": 150,
          "resizeMode": "contain"
        }
      ]
    ],
    "android": {
      "package": "com.drbedoya.citas"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "c1007952-fb86-4510-8f99-fde0cc9f7f54"
      }
    },
    "owner": "marlborovfx"
  }
}
